{
  "$schema": "https://cdn.jsdelivr.net/npm/@tscircuit/cli/types/tscircuit.config.schema.json",
  "mainEntrypoint": "panel.circuit.json",
  "includeBoardFiles": [
    "panel.circuit.json"
  ],
  "buildCommand": "tsci build --site --use-cdn-javascript --preview-images",
  "alwaysUseLatestTscircuitOnCloud": true,
  "ignoredFiles": [
    "dist/**",
    "checks/**",
    ".tscircuit/**",
    "node_modules/**",
    ".git/**",
    "bun.lock",
    ".npmrc"
  ]
}
